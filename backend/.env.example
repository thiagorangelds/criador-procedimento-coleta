# Copie para .env (ao lado do config.yml) ou exporte no ambiente do serviço.
# O que estiver aqui vence o config.yml e nunca é escrito de volta nele.

# Chave da API do Gemini, usada por todas as gerações deste servidor.
CRIADOR_API_KEY=

# Token exigido em todas as rotas /api, menos /api/saude.
# Obrigatório na prática sempre que CRIADOR_HOST não for 127.0.0.1.
CRIADOR_API_TOKEN=

# Endereço e porta de escuta.
CRIADOR_HOST=127.0.0.1
CRIADOR_PORTA=8765

# Origens liberadas no CORS, separadas por vírgula. Vazio = só o front que a
# própria API serve.
CRIADOR_CORS_ORIGENS=

# Onde os documentos gerados são gravados. Só precisa mudar em container, onde
# aponta para o volume (a imagem já define /dados).
# CRIADOR_PASTA_SAIDA=/dados
